{
	admin off
	auto_https off
}

# `route` blocks run their directives in the order written, instead of
# Caddy's default sorted order — needed here so /healthz is answered by
# `respond` before `try_files` can rewrite it to /index.html.
:8080 {
	root * /srv

	route /healthz {
		respond "ok" 200
	}

	route {
		encode gzip br

		# Hashed filenames under /assets/ never change content, so cache
		# them forever; the shell files always have to be revalidated or
		# a deploy would never reach an already-loaded tab.
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"

		@noCache path /index.html /sw.js /manifest.webmanifest
		header @noCache Cache-Control "no-cache"

		@wasm path *.wasm
		header @wasm Content-Type "application/wasm"

		try_files {path} /index.html
		file_server
	}
}
