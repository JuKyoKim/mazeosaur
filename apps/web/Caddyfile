{
	admin off
	auto_https off
}

# `route` blocks run their directives in the order written, instead of
# Caddy's default sorted order — needed here so /healthz is answered by
# `respond` before `try_files` can rewrite it to /index.html.
:8080 {
	root * /srv

	route /healthz {
		respond "ok" 200
	}

	route {
		encode gzip br

		# Hashed filenames under /assets/ never change content, so cache
		# them forever; the shell files always have to be revalidated or
		# a deploy would never reach an already-loaded tab.
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"

		@wasm path *.wasm
		header @wasm Content-Type "application/wasm"

		try_files {path} /index.html

		# AFTER try_files, on purpose. `path` matches the REQUEST path, and
		# `route` runs in written order -- so a matcher placed above the
		# rewrite sees `/`, never `/index.html`, and the shell ships with no
		# Cache-Control at all. Only the literal /index.html spelling, which
		# nothing requests, was getting the header.
		@noCache path /index.html /sw.js /manifest.webmanifest
		header @noCache Cache-Control "no-cache"

		file_server
	}
}
